{
  "name": "campus-connect-v4",
  "version": "4.0.0",
  "description": "Campus Connect v4.0 - University of Gujrat proposal management system with real-time notifications, analytics, and enterprise features",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:full": "concurrently \"npm run dev\" \"cd frontend && npm start\"",
    "setup": "node backend/scripts/setup_directories.js && node backend/scripts/run_schema.js",
    "setup:full": "npm run setup && npm run seed",
    "seed": "node backend/database/seed.js",
    "migrate": "node backend/database/scripts/run_all_migrations.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "build": "cd frontend && npm run build",
    "install:all": "npm install && cd frontend && npm install",
    "clean": "rm -rf node_modules frontend/node_modules",
    "lint": "eslint backend/ --ext .js",
    "format": "prettier --write backend/ frontend/src/",
    "redis:start": "redis-server",
    "redis:stop": "redis-cli shutdown"
  },
  "keywords": [
    "university",
    "management",
    "portal",
    "approval",
    "workflow",
    "societies",
    "react",
    "nodejs",
    "mysql",
    "fyp",
    "uog"
  ],
  "author": "Campus Connect Team - University of Gujrat",
  "license": "Educational",
  "repository": {
    "type": "git",
    "url": "https://github.com/GodZilla-lct/FYP-2-.git"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.6.0",
    "nodemailer": "^6.9.7",
    "redis": "^4.6.11",
    "socket.io": "^4.6.0",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "concurrently": "^8.2.0",
    "eslint": "^8.45.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.20",
    "prettier": "^3.0.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
